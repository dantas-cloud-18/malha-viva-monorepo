# Copie para .env (o setup.sh faz isso e gera os segredos). NUNCA versione o .env.
# Host publico: <IP-da-VM>.sslip.io (ou dominio DuckDNS). Caddy emite o HTTPS sozinho.
DOMAIN=203.0.113.10.sslip.io

DB_NAME=malhaviva
DB_USER=malhaviva
DB_PASSWORD=TROQUE_ME

# Segredos: o setup.sh preenche com `openssl rand -base64 48` se estiverem vazios.
MALHAVIVA_PEPPER=
MALHAVIVA_JWT_SECRET=
MALHAVIVA_OTP_KEY=

# ATENCAO: SOMENTE PARA O PILOTO. Com true, o servidor aceita captcha e integridade (Play Integrity)
# falsos, pois o APK de piloto usa stubs. NAO use em producao aberta ao publico.
MALHAVIVA_DEV_CAPTCHA=true
MALHAVIVA_DEV_INTEGRITY=true

# "log" = codigos OTP vao para o log do servidor (nenhum SMS/e-mail e enviado).
MALHAVIVA_MESSAGE_SENDER=log
